# Production build. The API and GoTrue are on the API subdomain.
# The deploy workflow overrides these for pre-launch (api.<server-ip>.sslip.io).
# No secrets here: everything in a frontend build is public.
VITE_API_ORIGIN=https://api.lam7ai.com
VITE_GOTRUE_URL=https://api.lam7ai.com/auth
VITE_BRAND=lam7a
